<?xml version="1.0"?>
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>Default</Name>
            <ViewSelectedBy>
                <TypeName>PSSharp.PowerShell.RabbitMQ.Commands.PSRabbitConnection</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader />
                    <TableColumnHeader />
                    <TableColumnHeader />
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>IsOpen</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>InstanceId</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>Default</Name>
            <ViewSelectedBy>
                <TypeName>PSSharp.PowerShell.RabbitMQ.Commands.PSRabbitMessage</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <PropertyName>Body</PropertyName>
                            </ListItem>
                            <ListItem>
                                <ItemSelectionCondition>
                                    <ScriptBlock>$null -eq $_.Body</ScriptBlock>
                                </ItemSelectionCondition>
                                <PropertyName>RawBody</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Exchange</Label>
                                <ScriptBlock><![CDATA[
                                    if ($_.Exchange -eq '') {
                                        $PSStyle.Dim + 'amq.default' + $PSStyle.Reset
                                    } else {
                                        $_.Exchange
                                    }
                                ]]></ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <PropertyName>RoutingKey</PropertyName>
                            </ListItem>
                            <ListItem>
                                <ItemSelectionCondition>
                                    <PropertyName>Redelivered</PropertyName>
                                </ItemSelectionCondition>
                                <PropertyName>Redelivered</PropertyName>
                            </ListItem>
                            <ListItem>
                                <ItemSelectionCondition>
                                    <ScriptBlock>$null -ne $_.MessageCount</ScriptBlock>
                                </ItemSelectionCondition>
                                <PropertyName>MessageCount</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>BasicProperties.ContentType</Label>
                                <ItemSelectionCondition>
                                    <ScriptBlock>$_.BasicProperties.ContentType</ScriptBlock>
                                </ItemSelectionCondition>
                                <ScriptBlock>$_.BasicProperties.ContentType</ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>BasicProperties.Headers</Label>
                                <ItemSelectionCondition>
                                    <ScriptBlock>$_.BasicProperties.Headers.Count -gt 0</ScriptBlock>
                                </ItemSelectionCondition>
                                <ScriptBlock>$_.BasicProperties.Headers</ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>BasicProperties.DeliveryMode</Label>
                                <ItemSelectionCondition>
                                    <ScriptBlock>$_.BasicProperties.DeliveryMode</ScriptBlock>
                                </ItemSelectionCondition>
                                <ScriptBlock>$_.BasicProperties.DeliveryMode</ScriptBlock>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
        <View>
            <Name>Default</Name>
            <ViewSelectedBy>
                <TypeName>PSSharp.PowerShell.RabbitMQ.Commands.Management.ExchangeDetails</TypeName>
            </ViewSelectedBy>
            <GroupBy>
                <PropertyName>VirtualHost</PropertyName>
            </GroupBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader />
                    <TableColumnHeader />
                    <TableColumnHeader />
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <ScriptBlock><![CDATA[
                                    if ($_.Name -eq '') {
                                        $PSStyle.Dim + 'amq.default' + $PSStyle.Reset
                                    } elseif ($_.Internal) {
                                        $PSStyle.Strikethrough + $_.Name + $PSStyle.Reset
                                    } else {
                                        $_.Name
                                    }
                                ]]></ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Type</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Durable</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>AutoDelete</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>