    <AssemblyName>PSSharp.PowerShell.RabbitMQ.Commands</AssemblyName>
    <RootNamespace>PSSharp.PowerShell.RabbitMQ.Commands</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.PowerShell.SDK"
      Version="7.6.9"
      ExcludeAssets="runtime"
      PrivateAssets="all"
